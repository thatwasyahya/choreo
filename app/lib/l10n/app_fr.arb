{
  "@@locale": "fr",

  "appTitle": "Choreo",
  "@appTitle": {
    "description": "Le nom du produit. Ne se traduit pas."
  },

  "checkTitle": "Vérification",
  "@checkTitle": {
    "description": "Titre de l'écran de vérification technique, avant les vrais écrans."
  },

  "serverSection": "Serveur",
  "@serverSection": {
    "description": "En-tête de la section qui rend compte du serveur."
  },

  "localSection": "Base locale",
  "@localSection": {
    "description": "En-tête de la section qui rend compte de la base du téléphone."
  },

  "serverChecking": "Vérification…",
  "@serverChecking": {
    "description": "Affiché pendant l'appel au serveur."
  },

  "serverReachable": "Joignable, version {version}",
  "@serverReachable": {
    "description": "Le serveur a répondu.",
    "placeholders": {
      "version": { "type": "String" }
    }
  },

  "serverUnreachable": "Injoignable",
  "@serverUnreachable": {
    "description": "Le serveur n'a pas répondu. Ce n'est pas une erreur : l'app fonctionne sans lui."
  },

  "tasksStored": "{count, plural, =0{Aucune tâche} =1{1 tâche} other{{count} tâches}}",
  "@tasksStored": {
    "description": "Nombre de tâches vivantes dans la base du téléphone.",
    "placeholders": {
      "count": { "type": "int" }
    }
  },

  "pendingToSend": "{count, plural, =0{Rien à envoyer} =1{1 geste à envoyer} other{{count} gestes à envoyer}}",
  "@pendingToSend": {
    "description": "Taille de la boîte d'envoi. Affiché à la place d'un indicateur d'activité : « 3 gestes à envoyer » est honnête, un sablier ne l'est pas.",
    "placeholders": {
      "count": { "type": "int" }
    }
  },

  "quarantinedRows": "{count, plural, =1{1 ligne mise de côté} other{{count} lignes mises de côté}}",
  "@quarantinedRows": {
    "description": "Lignes reçues du serveur que cette version n'a pas su appliquer. Affiché seulement si le nombre est supérieur à zéro : elles ne bloquent jamais la synchronisation.",
    "placeholders": {
      "count": { "type": "int" }
    }
  },

  "retry": "Réessayer",
  "@retry": {
    "description": "Relance la vérification."
  },

  "offlineNote": "Cet écran fonctionne sans réseau : tout est lu dans la base du téléphone.",
  "@offlineNote": {
    "description": "Rappelle que l'app est hors-ligne d'abord, pas hors-ligne tolérée."
  }
}
