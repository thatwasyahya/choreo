# Copy to .env and adjust for your machine. .env is git-ignored and must never
# be committed: the pre-commit hook will refuse it.

# --- server -----------------------------------------------------------------
# dev | test | prod
CHOREO_ENV=dev
CHOREO_HTTP_ADDR=:8080
CHOREO_LOG_LEVEL=info
CHOREO_SHUTDOWN_TIMEOUT=15s

# Host is "postgres" inside compose, "localhost" when running the server on the
# host. Replace the password locally; this placeholder is not a credential.
CHOREO_DATABASE_URL=postgres://choreo:replace-me-locally@localhost:5432/choreo?sslmode=disable

# --- postgres container -----------------------------------------------------
POSTGRES_USER=choreo
POSTGRES_PASSWORD=replace-me-locally
POSTGRES_DB=choreo
